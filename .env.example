# Copy to .env for local runs. On Vercel set these in Project Settings -> Environment Variables.
TURSO_URL=libsql://your-db-name.region.turso.io
TURSO_TOKEN=paste-an-access-token-here

ERP_PUBLIC=1
ERP_SECRET_KEY=long-random-string
ERP_ADMIN_USER=admin            # optional, defaults to 'admin' (first-run seeded account)
ERP_ADMIN_PASSWORD=a-good-password   # seeds the first admin account
ERP_MANAGER_PIN=a-separate-pin       # unlocks admin actions for a cashier; falls back to ERP_ADMIN_PASSWORD
# ERP_TZ=Asia/Ulaanbaatar            # shop time zone for timestamps
# ERP_TRUST_PROXY=1                  # only behind your own reverse proxy (not needed on Vercel)
# ERP_PASSWORD is legacy: only used to seed the admin when ERP_ADMIN_PASSWORD is absent.
# ERP_DEBUG=1                       # local development only - never on a reachable host
# ERP_DB=/absolute/path/to/erp.db   (only used when TURSO_URL is empty)
