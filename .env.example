# Copy to .env for local runs. On Vercel set these in Project Settings -> Environment Variables.
TURSO_URL=libsql://your-db-name.region.turso.io
TURSO_TOKEN=paste-an-access-token-here

ERP_PUBLIC=1
ERP_SECRET_KEY=long-random-string
ERP_PASSWORD=a-pin-you-choose
# ERP_DEBUG=0
# ERP_DB=/absolute/path/to/erp.db   (only used when TURSO_URL is empty)
